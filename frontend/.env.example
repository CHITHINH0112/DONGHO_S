# ==============================================================================
# BRU_WATCH HAUTE HORLOGERIE - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.example
# Hướng dẫn: Sao chép nội dung file này thành '.env.local' hoặc '.env.development':
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API ENDPOINTS
# ------------------------------------------------------------------------------
# Đường dẫn API v1 của Backend Express (Dùng cho axios apiClient)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Địa chỉ gốc của Backend server (Dùng để load ảnh tĩnh upload / audio / media)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 (TÙY CHỌN CHO ĐĂNG NHẬP GOOGLE)
# ------------------------------------------------------------------------------
# Client ID từ Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
# Nếu không cung cấp, hệ thống vẫn hỗ trợ đăng ký / đăng nhập thường qua email và mật khẩu
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

