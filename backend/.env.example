# ==============================================================================
# BRU_WATCH HAUTE HORLOGERIE - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.example
# Hướng dẫn: Sao chép nội dung file này thành '.env' trong thư mục backend:
#   cp .env.example .env
# Sau đó điền các thông số thực tế của bạn trước khi khởi chạy server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Cổng chạy ứng dụng Backend Node.js / Express
PORT=5000

# Môi trường thực thi: 'development' | 'production' | 'test'
NODE_ENV=development

# Địa chỉ URL của Frontend Next.js (Dùng cho CORS và liên kết chuyển hướng)
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONFIGURATION (Sequelize ORM)
# ------------------------------------------------------------------------------
# Địa chỉ máy chủ MySQL (mặc định localhost: 127.0.0.1)
DB_HOST=127.0.0.1

# Cổng dịch vụ MySQL (mặc định: 3306)
DB_PORT=3306

# Tên cơ sở dữ liệu MySQL chính của dự án
DB_NAME=dongho_shop2

# Tên tài khoản MySQL (mặc định: root)
DB_USER=root

# Mật khẩu tài khoản MySQL (để trống nếu root không đặt mật khẩu)
DB_PASSWORD=

# Hệ quản trị CSDL sử dụng với Sequelize
DB_DIALECT=mysql

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Khóa bí mật ký Access Token ngắn hạn (Bắt buộc thay đổi trong môi trường production)
JWT_SECRET=super_luxury_watch_secret_key_2026

# Thời hạn hiệu lực của Access Token (ví dụ: '1h', '2h', '1d', '7d')
JWT_EXPIRES_IN=7d

# Khóa bí mật ký Refresh Token dài hạn
JWT_REFRESH_SECRET=super_luxury_watch_refresh_secret_key_2026

# Thời hạn hiệu lực của Refresh Token (ví dụ: '7d', '30d')
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE & SMTP CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
# Hệ thống hỗ trợ gửi Email tự động:
# - Mua hàng thành công (Kèm chi tiết cỗ máy, serial, vận đơn GHN, bảo hiểm)
# - Đặt lịch dịch vụ thành công (Kèm mã phiếu #TK-xxx, địa chỉ tiếp nhận salon/tận nơi)
# Lưu ý: Nếu để trống USER/PASS, hệ thống sẽ tự động dùng Ethereal Sandbox và in link preview lên terminal.

# Dịch vụ email: 'gmail' hoặc để trống nếu dùng custom SMTP Host
EMAIL_SERVICE=gmail

# Máy chủ SMTP gửi thư (ví dụ: smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com

# Cổng SMTP (587: STARTTLS, 465: SSL)
EMAIL_PORT=587

# Bật mã hóa SSL trực tiếp (true cho port 465, false cho port 587)
EMAIL_SECURE=false

# Địa chỉ Email gửi đi (Gmail hoặc email tên miền boutique)
EMAIL_USER=concierge@bruwatch.geneve.ch

# Mật khẩu ứng dụng (App Password) của Gmail (16 ký tự tạo trong Google Account Security)
EMAIL_PASS=your_app_password_here

# ------------------------------------------------------------------------------
# 5. VNPAY SANDBOX PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Thông tin cổng thanh toán trực tuyến thử nghiệm của VNPay
# Website quản lý Merchant Sandbox: https://sandbox.vnpayment.vn/merchantv2/
# Tài liệu tích hợp: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html

# Terminal ID / Mã Website do VNPay cấp
VNP_TMN_CODE=NCO45ENA

# Secret Key / Chuỗi bí mật dùng để tạo chữ ký checksum HMAC-SHA512
VNP_HASH_SECRET=MENV9JOG5HRMPH7BZOMXE79XOC0LF8Y4

# URL cổng thanh toán môi trường thử nghiệm (TEST Sandbox)
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL nhận phản hồi kết quả giao dịch chuyển hướng về cho Frontend
VNP_RETURN_URL=http://localhost:3000/checkout/success

# ------------------------------------------------------------------------------
# 6. GIAO HÀNG NHANH (GHN EXPRESS) SANDBOX CONFIGURATION
# ------------------------------------------------------------------------------
# Cấu hình API tính cước vận chuyển tự động và tạo vận đơn GHN Express
# Cổng quản lý GHN 5 Sao Live: https://5sao.ghn.dev

# Endpoint Gateway Sandbox của GHN
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# Token API của tài khoản thử nghiệm GHN
GHN_TOKEN=2177f7b7-989f-4cd8-982b-52a842632b5f

# Mã định danh Shop trên hệ thống GHN Express
GHN_SHOP_ID=239197

# Mã Quận/Huyện kho hàng xuất phát (1442: Quận 1, TP. Hồ Chí Minh)
GHN_SHOP_DISTRICT_ID=1442

# Mã Phường/Xã kho hàng xuất phát (20101: Phường Bến Nghé)
GHN_SHOP_WARD_CODE=20101

# Tên Tỉnh / Thành phố của Boutique Flagship
SHOP_PROVINCE=TP. Hồ Chí Minh

# Tên Quận / Huyện của Boutique Flagship
SHOP_DISTRICT=Quận 1
